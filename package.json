{
  "name": "executive-hq",
  "version": "0.1.0",
  "private": true,
  "description": "Executive HQ — a playable pixel-art virtual headquarters staffed by autonomous AI employees.",
  "scripts": {
    "dev": "concurrently -k -n web,worker -c cyan,magenta \"next dev -p 3000\" \"tsx watch --env-file=.env worker/index.ts\"",
    "dev:web": "next dev -p 3000",
    "worker": "tsx --env-file=.env worker/index.ts",
    "build": "prisma generate && next build",
    "start": "concurrently -k -n web,worker \"next start -p 3000\" \"tsx --env-file=.env worker/index.ts\"",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file=.env --test --test-force-exit --test-timeout=60000 tests/*.test.ts",
    "test:e2e": "node tests/e2e.cjs && node tests/e2e-features.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.15",
    "next": "^15.5.28",
    "phaser": "^3.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}

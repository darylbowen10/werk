# ---- Core ----
DATABASE_URL="postgresql://exechq:exechq@localhost:5432/exechq"
# Optional. Enables realtime pub/sub between the worker and web app. Without it, SSE falls back to DB polling.
REDIS_URL="redis://localhost:6379"
# Required. Signs session cookies. Generate: openssl rand -base64 48
AUTH_SECRET=""
# Required. 32-byte key (base64) for AES-256-GCM encryption of integration credentials. Generate: openssl rand -base64 32
ENCRYPTION_KEY=""
APP_URL="http://localhost:3000"

# ---- AI (Claude) ----
# Without a key the game runs in clearly-labelled OFFLINE SIMULATION mode (deterministic, data-driven, no LLM).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# ---- Worker ----
WORKER_POLL_MS="1500"
# Hour (0-23, server local time) when the Executive Assistant prepares the morning briefing.
BRIEFING_HOUR="6"

# ---- OAuth integrations (optional; connectors show "not configured" until set) ----
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
SALESFORCE_CLIENT_ID=""
SALESFORCE_CLIENT_SECRET=""
